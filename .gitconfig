[user]
	name = Masalale
	email = clarenchomba59@gmail.com
[core]
	autocrlf = input
[init]
	defaultBranch = main
[safe]
	directory = /home/ngash/flutter
	directory = %(prefix)///wsl.localhost/FedoraLinux-43/home/ngash/flutter
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/home/ngash/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/ngash/.local/bin/gh auth git-credential
